# Cartella dove vengono salvati risposte e materiali caricati.
# Su Railway: puntala al percorso del Volume che colleghi al servizio (es. /data).
# In locale: lasciala vuota, userà .local-storage/ dentro il progetto.
STORAGE_DIR=

# Password semplice per proteggere le pagine /admin/[token]. Cambiala.
ADMIN_PASSWORD=cambia-questa-password

# Facoltativo: solo se in futuro sposti l'hosting su Vercel e vuoi usare Vercel Blob
# invece del disco persistente di Railway.
BLOB_READ_WRITE_TOKEN=

# --- Sito Vittoria Ribighini (/vittoria) ---------------------------------
# Facoltativa: senza chiave il chatbot risponde comunque, con il motore
# deterministico di lib/vittoria/knowledge.js. Con la chiave risponde Claude.
ANTHROPIC_API_KEY=

# Facoltativa: modello usato dal chatbot (default claude-opus-5).
VR_CHAT_MODEL=
